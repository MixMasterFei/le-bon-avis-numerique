  status    String // "success", "error", "partial"
  summary   String? // Human-readable one-liner
  details   Json? // { imported: 5, errors: 0, duration: 12345, ... }
  duration  Int? // milliseconds
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([task])
  @@map("cron_logs")
}

