// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTHENTICATION MODELS (NextAuth.js)
// ============================================

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?   // For credentials auth
  avatarStyle   String?   @map("avatar_style")
  avatarSeed    String?   @map("avatar_seed")
  avatarOptions Json?     @map("avatar_options")
  role                UserRole  @default(USER)
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  // "Météo famille" widget on /apercudecouverte-v3. Cross-device so
  // home PC, work PC, and phone all show the same city. NULL = the
  // user hasn't picked one and we fall back to Paris.
  weatherCityName     String?   @map("weather_city_name")
  weatherCityLat      Float?    @map("weather_city_lat")
  weatherCityLon      Float?    @map("weather_city_lon")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  accounts           Account[]
  sessions           Session[]
  reviews            Review[]
  favorites          Favorite[]
  watchlist          Watchlist[]
  reports            ReviewReport[]
  familyMembers      FamilyMember[]
  familySettings     FamilySettings?
  corrections        MediaCorrection[]
  contentRequests    ContentRequest[]
  userContentMetrics UserContentMetrics[]
  adminActivities    AdminActivity[]
  ageVotes           AgeVote[]
  familyWarningVotes FamilyWarningVote[]
  newsComments          NewsComment[]
  newsCommentReactions  NewsCommentReaction[]
  newsCommentReports    NewsCommentReport[]
  newsStoryReactions    NewsStoryReaction[]
  newsSavedStories      NewsSavedStory[]
  notifications         Notification[]
  totemConversations    TotemConversation[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

// ============================================
// MEDIA MODELS
// ============================================

enum MediaType {
  MOVIE
  TV
  GAME
  BOOK
  APP
  MANGA
}

enum ReviewerRole {
  PARENT
  KID
  EDUCATOR
}

model MediaItem {
  id              String    @id @default(uuid())
  title           String
  originalTitle   String?   @map("original_title")
  type            MediaType
  releaseDate     DateTime? @map("release_date")
  posterUrl       String?   @map("poster_url")
  backdropUrl     String?   @map("backdrop_url")
  synopsisFr      String?   @map("synopsis_fr") @db.Text
  officialRating  String?   @map("official_rating")
  expertAgeRec    Int?      @map("expert_age_rec")
  communityAgeRec Float?    @map("community_age_rec")
  duration        Int? // minutes for movies/shows, null for others
  numberOfSeasons Int?      @map("number_of_seasons") // For TV shows only
  director        String?
  genres          String[]
  platforms       String[] // Netflix, Disney+, Canal+, etc.
  topics          String[] // Princesses, Dinosaurs, History, etc.
  originalLanguage String? @map("original_language") // ISO 639-1 code (fr, en, de, etc.)

  // External API IDs for syncing
  // Note: tmdbId is unique per type (movies and TV have separate namespaces in TMDB)
  tmdbId       Int?    @map("tmdb_id")
  igdbId       Int?    @unique @map("igdb_id")
  googleBookId String? @unique @map("google_book_id")
  anilistId    Int?    @unique @map("anilist_id") // Manga series, from AniList GraphQL

  // Manga-specific fields (populated for type = MANGA; null for other types)
  volumeCount      Int?      @map("volume_count")        // Tankōbon count
  chapterCount     Int?      @map("chapter_count")       // For ongoing series where volumes lag chapters
  demographic      String?                                // "shounen" | "shoujo" | "seinen" | "josei"
  status           String?                                // "ongoing" | "completed" | "hiatus"
  latestVolumeDate DateTime? @map("latest_volume_date")  // Drives /mangas sort=newest + Nouveautés rail

  // TMDB audience ratings (used internally for quality ranking, not displayed)
  tmdbRating     Float? @map("tmdb_rating")      // vote_average (0-10 scale)
  tmdbVoteCount  Int?   @map("tmdb_vote_count")  // number of votes

  // Data quality tracking
  dataSource       DataSource @default(TMDB) @map("data_source")
  dataQualityScore Int        @default(0) @map("data_quality_score") // 0-100
  isEnriched       Boolean    @default(false) @map("is_enriched") // Has expert content
  lastVerifiedAt   DateTime?  @map("last_verified_at")
  enrichedBy       String?    @map("enriched_by") // User ID who enriched

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contentMetrics        ContentMetrics?
  reviews               Review[]
  favorites             Favorite[]
  watchlist             Watchlist[]
  reactions             MediaReaction[]
  credits               MediaCredit[]
  similarToA            MediaSimilarity[] @relation("SimilarMediaA")
  similarToB            MediaSimilarity[] @relation("SimilarMediaB")
  streamingAvailability StreamingAvailability[]
  corrections           MediaCorrection[]
  userContentMetrics    UserContentMetrics[]
  contentRequests       ContentRequest[]
  screenshots           MediaScreenshot[]
  ageVotes              AgeVote[]
  familyWarningVotes    FamilyWarningVote[]
  recoClicks            RecoClick[]

  @@unique([tmdbId, type]) // tmdbId unique per type (TMDB has separate ID namespaces)
  @@index([type])
  @@index([expertAgeRec])
  @@index([dataQualityScore])
  @@index([isEnriched])
  @@index([tmdbId])
  @@index([originalLanguage])
  @@index([releaseDate])
  @@index([type, releaseDate])
  @@index([type, latestVolumeDate]) // drives "Nouveautés manga" rail + /mangas sort=newest
  @@map("media_items")
}

enum DataSource {
  TMDB
  IGDB
  GOOGLE_BOOKS
  ANILIST     // Manga series metadata
  EXPERT      // Manually entered by expert
  COMMUNITY   // User-submitted
}

model ContentMetrics {
  id                    String   @id @default(uuid())
  mediaId               String   @unique @map("media_id")
  violence              Int      @default(0) // 0-5 scale
  sexNudity             Int      @default(0) @map("sex_nudity")
  language              Int      @default(0)
  consumerism           Int      @default(0)
  substanceUse          Int      @default(0) @map("substance_use")
  positiveMessages      Int      @default(0) @map("positive_messages")
  roleModels            Int      @default(0) @map("role_models")
  whatParentsNeedToKnow String[] @map("what_parents_need_to_know")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Enrichment v2 fields
  enrichmentConfidence Float?    @map("enrichment_confidence")
  enrichmentSource     String    @default("METADATA_ONLY") @map("enrichment_source")
  needsDeepEnrich      Boolean   @default(false) @map("needs_deep_enrich")
  toneTags             String[]  @default([]) @map("tone_tags")
  pacing               String?   @map("pacing")
  visualStyle          String?   @map("visual_style")
  emotionalThemes      String[]  @default([]) @map("emotional_themes")
  pass1At              DateTime? @map("pass1_at")
  pass2At              DateTime? @map("pass2_at")

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@map("content_metrics")
}

model Review {
  id              String        @id @default(uuid())
  userId          String?       @map("user_id")
  mediaId         String        @map("media_id")
  familyMemberId  String?       @map("family_member_id") // Optional: which family member wrote this
  role            ReviewerRole
  rating          Int // 1-5 stars
  ageSuggestion   Int?          @map("age_suggestion")
  comment         String?       @db.Text
  isVerified      Boolean       @default(false) @map("is_verified")
  editedAt        DateTime?     @map("edited_at") // Null if never edited
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  media        MediaItem     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  familyMember FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  @@index([mediaId])
  @@index([userId])
  @@index([familyMemberId])
  @@map("reviews")
}

// ============================================
// USER INTERACTIONS
// ============================================

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  mediaId   String   @map("media_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([mediaId])
  @@map("favorites")
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  mediaId   String   @map("media_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([mediaId])
  @@map("watchlist")
}

// ============================================
// MODERATION
// ============================================

enum ReportReason {
  INAPPROPRIATE
  SPAM
  HARASSMENT
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model ReviewReport {
  id        String       @id @default(uuid())
  reviewId  String       @map("review_id")
  userId    String       @map("user_id")
  reason    ReportReason
  details   String?      @db.Text
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([status])
  @@map("review_reports")
}

// ============================================
// FAMILY MEMBERS & REACTIONS
// ============================================

model FamilyMember {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  birthYear       Int?     @map("birth_year")
  birthMonth      Int?     @map("birth_month")
  avatarEmoji     String   @default("👧") @map("avatar_emoji")
  avatarStyle     String?  @map("avatar_style")
  avatarSeed      String?  @map("avatar_seed")
  avatarOptions   Json?    @map("avatar_options")
  favoriteGenres  String[] @default([]) @map("favorite_genres")  // Genres préférés
  dislikedGenres  String[] @default([]) @map("disliked_genres")  // Genres à éviter

  // Content sensitivity preferences (0 = don't care, 1 = low tolerance, 2 = moderate, 3 = strict)
  sensitivityViolence   Int @default(2) @map("sensitivity_violence")
  sensitivityScary      Int @default(2) @map("sensitivity_scary")
  sensitivitySexual     Int @default(3) @map("sensitivity_sexual")
  sensitivityLanguage   Int @default(2) @map("sensitivity_language")
  sensitivitySubstances Int @default(2) @map("sensitivity_substances")

  // Positive content preferences (0 = don't care, 1 = nice to have, 2 = prefer, 3 = must have)
  preferPositiveMessages Int @default(1) @map("prefer_positive_messages")
  preferRoleModels       Int @default(1) @map("prefer_role_models")
  preferEducational      Int @default(1) @map("prefer_educational")

  // Topics/themes to avoid (explicit list)
  avoidTopics String[] @default([]) @map("avoid_topics")

  // Personal interests (dinosaurs, space, princesses, etc.)
  interests String[] @default([]) @map("interests")

  // Use custom settings or inherit from account defaults
  useCustomSettings Boolean @default(false) @map("use_custom_settings")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions MediaReaction[]
  reviews   Review[]

  @@index([userId])
  @@map("family_members")
}

enum ReactionType {
  WATCHED    // Déjà vu
  LOVED      // Adoré
  LIKED      // Bien aimé
  OK         // Bof
  SCARED     // A eu peur
  BORED      // S'est ennuyé
  TOO_YOUNG  // Trop jeune pour comprendre
  TOO_OLD    // Trop vieux (pas intéressé)
}

model MediaReaction {
  id             String       @id @default(uuid())
  familyMemberId String       @map("family_member_id")
  mediaId        String       @map("media_id")
  reaction       ReactionType
  note           String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  familyMember FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  media        MediaItem    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([familyMemberId, mediaId])
  @@index([mediaId])
  @@map("media_reactions")
}

// ============================================
// TAXONOMY - Normalized Genres & Topics
// ============================================

model Genre {
  id        String  @id @default(uuid())
  slug      String  @unique // "animation", "comedy"
  name      String  // "Animation"
  nameFr    String  @map("name_fr") // "Animation"
  tmdbId    Int?    @unique @map("tmdb_id")
  igdbId    Int?    @unique @map("igdb_id")
  parentId  String? @map("parent_id") // For hierarchy

  parent   Genre?  @relation("GenreHierarchy", fields: [parentId], references: [id])
  children Genre[] @relation("GenreHierarchy")

  @@map("genres")
}

// ============================================
// CAST & CREW
// ============================================

model Person {
  id          String  @id @default(uuid())
  name        String
  tmdbId      Int?    @unique @map("tmdb_id")
  igdbId      Int?    @unique @map("igdb_id")
  imageUrl    String? @map("image_url")
  knownFor    String? @map("known_for") // "Director", "Actor"

  credits MediaCredit[]

  @@index([name])
  @@map("persons")
}

model MediaCredit {
  id        String  @id @default(uuid())
  mediaId   String  @map("media_id")
  personId  String  @map("person_id")
  role      CreditRole
  character String? // For actors: character name
  order     Int?    // Billing order

  media  MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  person Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([mediaId, personId, role])
  @@index([personId])
  @@map("media_credits")
}

enum CreditRole {
  DIRECTOR
  ACTOR
  WRITER
  COMPOSER
  PRODUCER
  DEVELOPER  // For games
  AUTHOR     // For books
}

// ============================================
// MEDIA SIMILARITY (for recommendations)
// ============================================

model MediaSimilarity {
  id              String   @id @default(uuid())
  mediaIdA        String   @map("media_id_a")
  mediaIdB        String   @map("media_id_b")
  similarityScore Float    @map("similarity_score") // 0.0 - 1.0
  reasons         String[] // ["same_director", "similar_themes", "same_studio"]
  source          SimilaritySource @default(ALGORITHM)
  createdAt       DateTime @default(now()) @map("created_at")

  mediaA MediaItem @relation("SimilarMediaA", fields: [mediaIdA], references: [id], onDelete: Cascade)
  mediaB MediaItem @relation("SimilarMediaB", fields: [mediaIdB], references: [id], onDelete: Cascade)

  @@unique([mediaIdA, mediaIdB])
  @@index([mediaIdA])
  @@index([mediaIdB])
  @@index([similarityScore])
  @@map("media_similarities")
}

enum SimilaritySource {
  ALGORITHM   // Auto-computed
  TMDB        // From TMDB similar movies
  EXPERT      // Manually curated
  COMMUNITY   // User-suggested
}

// ============================================
// STREAMING AVAILABILITY
// ============================================

model StreamingAvailability {
  id             String    @id @default(uuid())
  mediaId        String    @map("media_id")
  provider       String    // "Netflix", "Disney+"
  providerId     Int?      @map("provider_id") // TMDB/JustWatch provider ID
  country        String    @default("FR") // ISO country code
  type           StreamingType
  availableFrom  DateTime? @map("available_from")
  availableUntil DateTime? @map("available_until")
  link           String?   // Direct link to watch
  lastChecked    DateTime  @default(now()) @map("last_checked")

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, provider, country, type])
  @@index([provider])
  @@index([country])
  @@index([lastChecked])
  @@map("streaming_availability")
}

enum StreamingType {
  SUBSCRIPTION  // Flatrate (Netflix, Disney+)
  RENT
  BUY
  FREE
  ADS           // Free with ads
}

// ============================================
// USER CORRECTIONS & ERROR REPORTS
// ============================================

model MediaCorrection {
  id          String           @id @default(uuid())
  mediaId     String           @map("media_id")
  userId      String           @map("user_id")
  type        CorrectionType
  field       String?          // Which field needs correction (e.g., "title", "synopsis", "age_rating")
  currentValue String?         @map("current_value") @db.Text // Current incorrect value
  suggestedValue String?       @map("suggested_value") @db.Text // User's suggested correction
  description String           @db.Text // User's explanation of the error
  status      CorrectionStatus @default(PENDING)
  adminNotes  String?          @map("admin_notes") @db.Text
  reviewedAt  DateTime?        @map("reviewed_at")
  reviewedBy  String?          @map("reviewed_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("media_corrections")
}

enum CorrectionType {
  WRONG_INFO      // Information incorrecte
  MISSING_INFO    // Information manquante
  AGE_RATING      // Recommandation d'âge incorrecte
  CONTENT_WARNING // Avertissement de contenu manquant
  BROKEN_LINK     // Lien cassé (streaming, poster)
  DUPLICATE       // Doublon dans la base
  OTHER           // Autre
}

enum CorrectionStatus {
  PENDING   // En attente de revue
  REVIEWED  // Revue en cours
  APPROVED  // Approuvée et appliquée
  REJECTED  // Rejetée
  DUPLICATE // Déjà signalé
}

// ============================================
// CONTENT REQUESTS (User requests for new content)
// ============================================

enum ContentRequestStatus {
  PENDING   // En attente
  REVIEWING // En cours de revue
  APPROVED  // Approuvé
  ADDED     // Ajouté à la base
  REJECTED  // Rejeté
  DUPLICATE // Déjà présent
}

model ContentRequest {
  id          String               @id @default(uuid())
  userId      String               @map("user_id")
  title       String
  mediaType   MediaType            @map("media_type")
  externalId  String?              @map("external_id") // TMDB/IGDB ID if known
  description String?              @db.Text
  status      ContentRequestStatus @default(PENDING)
  priority    Int                  @default(0)
  adminNotes  String?              @map("admin_notes") @db.Text
  resolvedAt  DateTime?            @map("resolved_at")
  resolvedBy  String?              @map("resolved_by")
  mediaId     String?              @map("media_id") // Link to created media item
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  media MediaItem? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@map("content_requests")
}

// ============================================
// USER CONTENT METRICS (Community ratings)
// ============================================

model UserContentMetrics {
  id               String   @id @default(uuid())
  mediaId          String   @map("media_id")
  userId           String   @map("user_id")
  violence         Int      @default(0) // 0-5 scale
  sexNudity        Int      @default(0) @map("sex_nudity")
  language         Int      @default(0)
  consumerism      Int      @default(0)
  substanceUse     Int      @default(0) @map("substance_use")
  positiveMessages Int      @default(0) @map("positive_messages")
  roleModels       Int      @default(0) @map("role_models")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mediaId, userId])
  @@index([mediaId])
  @@map("user_content_metrics")
}

// ============================================
// FAMILY SETTINGS (Account-wide defaults)
// ============================================

model FamilySettings {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // Display settings
  blur18Plus Boolean @default(true) @map("blur_18_plus") // Blur 18+ content posters

  // Default sensitivity levels for the whole family (0 = don't care, 1 = low tolerance, 2 = moderate, 3 = strict)
  defaultSensitivityViolence   Int @default(2) @map("default_sensitivity_violence")
  defaultSensitivityScary      Int @default(2) @map("default_sensitivity_scary")
  defaultSensitivitySexual     Int @default(3) @map("default_sensitivity_sexual")
  defaultSensitivityLanguage   Int @default(2) @map("default_sensitivity_language")
  defaultSensitivitySubstances Int @default(2) @map("default_sensitivity_substances")

  // Default positive preferences (0 = don't care, 1 = nice to have, 2 = prefer, 3 = must have)
  defaultPreferPositiveMessages Int @default(1) @map("default_prefer_positive_messages")
  defaultPreferRoleModels       Int @default(1) @map("default_prefer_role_models")
  defaultPreferEducational      Int @default(1) @map("default_prefer_educational")

  // Account-wide blocked topics
  blockedTopics String[] @default([]) @map("blocked_topics")

  // Streaming platforms available in this family
  availablePlatforms String[] @default([]) @map("available_platforms")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("family_settings")
}

// ============================================
// MEDIA SCREENSHOTS (Cached from TMDB/IGDB)
// ============================================

model MediaScreenshot {
  id        String   @id @default(uuid())
  mediaId   String   @map("media_id")
  url       String   // Full URL or external path
  width     Int?
  height    Int?
  order     Int      @default(0) // Display order
  source    DataSource @default(TMDB) // TMDB, IGDB, etc.
  externalId String? @map("external_id") // Original ID from source API
  createdAt DateTime @default(now()) @map("created_at")

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@map("media_screenshots")
}

// ============================================
// ADMIN ACTIVITY LOGGING
// ============================================

model AdminActivity {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String   // IMPORT, ENRICH, DELETE, APPROVE_CORRECTION, etc.
  entityType String   @map("entity_type") // MEDIA, REVIEW, CORRECTION, etc.
  entityId   String?  @map("entity_id")
  details    String?  @db.Text // JSON or text details
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
  @@map("admin_activities")
}

