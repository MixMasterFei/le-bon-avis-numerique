// ============================================
// NEWS DISCOVERY (admin-only synthesized news feed)
// ============================================

enum NewsCategory {
  PARENTHOOD
  FILM_TV
  GAMES
  READING
  // Family-relevant tech & generative AI: parental tech, social
  // media regulation, screen-time tools, EdTech, ChatGPT-with-kids,
  // device launches that touch family life. Distinct from GAMES
  // (video game industry / releases).
  TECH
}

enum NewsStoryStatus {
  PUBLISHED
  ARCHIVED
  // Quality judge flagged the article — below threshold on
  // source-fidelity, neutrality, structural cleanliness, or length.
  // Hidden from public surfaces; surfaced in /admin for human review.
  PENDING_REVIEW
}

// Image provenance tier — set at synthesis time by news-image.ts.
// Used to display a photo credit pill (Perplexity-style) and to audit
// the ratio of agency/stock vs. publisher-scraped imagery on the page.
enum ImageSourceType {
  AGENCY         // Wire service (Reuters, AP, AFP, Getty, EPA…)
  STOCK          // Pexels or Unsplash — royalty-free, must link back
  PUBLISHER_RSS  // From RSS media:content / enclosure (publisher-syndicated)
  PUBLISHER_OG   // Scraped from <meta og:image> — highest legal risk, last resort
  FALLBACK       // Generated branded "zen card" (/api/news/fallback-card) — used when the article carries no usable photo, or only a thumbnail too small to render as a hero
}

model NewsStory {
  id             String          @id @default(uuid())
  slug           String          @unique
  title          String
  summary        String          @db.Text
  body           String          @db.Text
  category       NewsCategory
  sources        Json            // [{ name, url, favicon, headline, publishedAt }]
  imageUrl       String          @map("image_url")
  // Image provenance — drives the photo credit pill on cards and lets
  // us audit the legal posture of the image pool. Null on legacy rows
  // until the reprocess-images backfill runs.
  // AGENCY = wire/press service (Reuters, AP, AFP…), STOCK = Pexels/
  // Unsplash royalty-free, PUBLISHER_RSS = image the publisher itself
  // syndicated via RSS, PUBLISHER_OG = scraped from OG meta (last resort).
  imageSourceType ImageSourceType? @map("image_source_type")
  imageCredit     String?          @map("image_credit")        // e.g. "Reuters" or "Marc Dupont / Pexels"
  imageLicenseUrl String?          @map("image_license_url")   // STOCK only — links back to source page (Pexels/Unsplash require attribution)
  publishedAt    DateTime        @map("published_at")
  fetchedAt      DateTime        @default(now()) @map("fetched_at")
  relevanceScore Float           @default(0) @map("relevance_score")
  status         NewsStoryStatus @default(PUBLISHED)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  // Region the source publication is based in. "FR" = domestic French
  // press (existing default). "INTL" = synthesized + translated from
  // an international family-press source (NYT Parenting, BBC Family,
  // etc.). Drives the "Vu d'ailleurs" tab on /actualites.
  region         String          @default("FR")

  // Story format: BRIEF = standard 300-450 word news item,
  // DOSSIER = weekly long-read (800-1200 words) synthesizing 7 days
  // of coverage on a single theme. Featured at top of /actualites.
  storyType      String          @default("BRIEF") @map("story_type")

  // Audience verdict from the pass-2 moderator. kid_safe = anyone can
  // see, parent_only = adult eyes only (true crime, mature documentaries),
  // unsuitable = dropped before persistence (so "unsuitable" never
  // appears in the DB; field exists for future-proofing).
  audience       String          @default("parent_only")

  // "Ce que dit la recherche" sidebar — when the body cites a study,
  // a separate agent extracts the canonical reference. JSON shape:
  // { studyTitle, methodology, keyFinding, sampleSize, year, source, doi?, url? }
  // Null when no study citation is detected.
  research       Json?

  // Totem's family-angle interpretation, rendered as a boxed aside at
  // the end of the article — the "what this means for families" callout
  // the journalistic body deliberately avoids. The body stays neutral;
  // this field carries the parental framing.
  // 60-120 words, plain text (no markdown). Null on legacy briefs.
  familyTakeaway String?         @map("family_takeaway") @db.Text

  // Editorial supervision tags — set after synthesis by a lightweight
  // Haiku classifier (src/lib/news-editorial-judge.ts). Used by the
  // feed-level balancer to avoid stacking heavy stories at the top of
  // /apercudecouverte-v3.
  //   editorialTone: "positive" | "neutral" | "concerning" | "grave"
  //   topicCluster:  short kebab-case tag like "teen-suicide",
  //                  "screen-time", "sport", "cinema-release", …
  // Both nullable for backward compat with rows synthesized before
  // the editorial pass shipped. The balancer treats null tone as
  // "neutral" and null cluster as "_unclustered".
  editorialTone  String?         @map("editorial_tone")
  topicCluster   String?         @map("topic_cluster")

  // Primary catalog subject — set by the systemic news-media pipeline:
  // LLM identifies whether the story is about a media title/license,
  // catalog search finds matching rows, LLM verifies the candidates.
  // Null when no verified catalog match was found.
  relatedMediaId String?         @map("related_media_id")
  // Full ordered list of catalog matches (first match = primary).
  // Replaces the inline-linking approach: bodies stay clean, the
  // related items render as mini-cards at the bottom of the page.
  // Several can be displayed when a story is about a saga/franchise.
  relatedMediaIds String[]       @default([]) @map("related_media_ids")

  comments NewsComment[]
  storyReactions NewsStoryReaction[]
  savedBy NewsSavedStory[]

  @@index([publishedAt])
  @@index([category, status])
  @@index([region, status])
  @@index([storyType, status])
  @@map("news_stories")
}

// Cached results from Pexels / Unsplash searches keyed by the
// normalized story keyword set. Avoids re-hitting the free-tier APIs
// when the same story is regenerated by a later cron run, and keeps a
// stable image for stories that get updated (dedup layer B in
// news-discover.ts merges duplicates, but the cache makes sure the
// merged story keeps its original stock photo).
model StockImageCache {
  id              String   @id @default(uuid())
  // Lowercased, sorted, space-joined keyword set (e.g. "ecran enfants ecole").
  // Single key per (provider, keywords) so we don't duplicate entries.
  keywordsKey     String   @map("keywords_key")
  provider        String   // "pexels" | "unsplash"
  imageUrl        String   @map("image_url")
  credit          String                          // human-readable, e.g. "Marc Dupont / Pexels"
  licenseUrl      String   @map("license_url")    // back-link to the source page (required by both APIs)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([provider, keywordsKey])
  @@index([createdAt])
  @@map("stock_image_cache")
}

enum NewsCommentStatus {
  VISIBLE
  HIDDEN   // admin-hidden after moderation
  DELETED  // author-deleted (kept for audit)
}

model NewsComment {
  id          String            @id @default(uuid())
  newsStoryId String            @map("news_story_id")
  userId      String            @map("user_id")
  body        String            @db.Text
  status      NewsCommentStatus @default(VISIBLE)
  editedAt    DateTime?         @map("edited_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  newsStory NewsStory             @relation(fields: [newsStoryId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions NewsCommentReaction[]
  reports   NewsCommentReport[]

  @@index([newsStoryId, createdAt])
  @@index([userId])
  @@index([status])
  @@map("news_comments")
}

model NewsCommentReaction {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  type      String   // "THUMBS_UP" | "HEART" | "QUESTION" — plain string to allow adding types without schema change
  createdAt DateTime @default(now()) @map("created_at")

  comment NewsComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, type])
  @@index([commentId])
  @@map("news_comment_reactions")
}

model NewsCommentReport {
  id        String       @id @default(uuid())
  commentId String       @map("comment_id")
  userId    String       @map("user_id")
  reason    ReportReason
  details   String?      @db.Text
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  comment NewsComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([status])
  @@map("news_comment_reports")
}

model NewsStoryReaction {
  id          String   @id @default(uuid())
  newsStoryId String   @map("news_story_id")
  userId      String   @map("user_id")
  type        String   // "LIKE" | "DISLIKE"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  newsStory NewsStory @relation(fields: [newsStoryId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsStoryId, userId])
  @@index([newsStoryId])
  @@index([userId])
  @@map("news_story_reactions")
}

model NewsSavedStory {
  id          String    @id @default(uuid())
  newsStoryId String    @map("news_story_id")
  userId      String    @map("user_id")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  newsStory NewsStory @relation(fields: [newsStoryId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsStoryId, userId])
  @@index([newsStoryId])
  @@index([userId, createdAt])
  @@map("news_saved_stories")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  priority  String    @default("NORMAL")
  title     String
  body      String?   @db.Text
  href      String?
  metadata  Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([type])
  @@map("notifications")
}

// ============================================
// TOTEM ASSISTANT (RAG chatbot)
// ============================================

model TotemConversation {
  id                  String   @id @default(uuid())
  userId              String?  @map("user_id")
  sessionId           String   @map("session_id")
  startedAt           DateTime @default(now()) @map("started_at")
  lastMessageAt       DateTime @default(now()) @map("last_message_at")
  sourcePage          String?  @map("source_page")
  familyMemberContext Json?    @map("family_member_context")

  user     User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TotemMessage[]

  @@index([userId, startedAt])
  @@index([sessionId, startedAt])
  @@map("totem_conversations")
}

model TotemMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String   @db.Text
  toolCalls      Json?    @map("tool_calls")
  toolResults    Json?    @map("tool_results")
  citedMediaIds  String[] @default([]) @map("cited_media_ids")
  modelUsed      String?  @map("model_used")
  latencyMs      Int?     @map("latency_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation TotemConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback     TotemFeedback[]

  @@index([conversationId, createdAt])
  @@map("totem_messages")
}

model TotemFeedback {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  rating    String
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  message TotemMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("totem_feedback")
}
